# Frontend (public). VITE_ variables are bundled into the JavaScript every visitor downloads.
# Only the Supabase URL and the anon/publishable key belong here. RLS protects your data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# NEVER add the service_role key or an sb_secret_ key with a VITE_ prefix.
# Server-only keys go in Supabase Edge Function secrets (supabase secrets set ...)
# or your host's server-side environment variables. The build refuses to run if one slips in.

# Two-account RLS test (npm run test:rls). Create both users in
# Supabase > Authentication > Users > Add user (tick "Auto confirm"). Use test accounts only.
TEST_USER_A_EMAIL=test-a@example.com
TEST_USER_A_PASSWORD=change-me-A
TEST_USER_B_EMAIL=test-b@example.com
TEST_USER_B_PASSWORD=change-me-B
